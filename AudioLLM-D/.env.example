# Example .env file for AudioLLM-D project, copy this to .env and fill in the values before running any scripts.

# HuggingFace
HF_TOKEN=hf_your_token_here // token required to download Qwen2-Audio-7B-Instruct
HF_HOME=/scratch/hf_cache // Local cache directory for HF models/datasets (set to /scratch/hf_cache on RCP cluster)
HF_XET_HIGH_PERFORMANCE=1 // Enable XET high performance mode for faster inference on supported hardware
# HF_HUB_OFFLINE=1 // Uncomment to force offline mode (only use local cache, do not connect to HF servers)

# Weights & Biases — only needed when report_to: wandb in training config
WANDB_API_KEY=your_wandb_key_here
WANDB_PROJECT=audiollm-d
WANDB_ENTITY=lord-of-the-strings
WANDB_DIR=/scratch/wandb
WANDB_MODE=
